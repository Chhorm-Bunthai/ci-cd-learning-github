---
const greeting: string = "Hello, world";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hello, world</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Outfit:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --ink: #1a1033;
        --paper: #fff7ed;
        --coral: #ff5d4f;
        --amber: #ffb020;
        --teal: #14b8a6;
        --violet: #7c5cff;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem 1.25rem;
        font-family: Outfit, system-ui, sans-serif;
        color: var(--ink);
        background:
          radial-gradient(1200px 600px at 10% -10%, #ffd6c8 0%, transparent 55%),
          radial-gradient(900px 500px at 110% 10%, #c4b5fd 0%, transparent 50%),
          radial-gradient(800px 500px at 50% 120%, #99f6e4 0%, transparent 45%),
          linear-gradient(160deg, #fff1e6, #f5e8ff 55%, #e0fbf4);
      }

      .blob {
        position: fixed;
        border-radius: 50%;
        filter: blur(18px);
        opacity: 0.55;
        pointer-events: none;
        z-index: 0;
      }

      .blob-a {
        width: 18rem;
        height: 18rem;
        background: var(--coral);
        top: 8%;
        left: -4rem;
        animation: drift 12s ease-in-out infinite;
      }

      .blob-b {
        width: 14rem;
        height: 14rem;
        background: var(--teal);
        right: -3rem;
        bottom: 12%;
        animation: drift 10s ease-in-out infinite reverse;
      }

      .blob-c {
        width: 10rem;
        height: 10rem;
        background: var(--amber);
        top: 42%;
        right: 18%;
        animation: drift 14s ease-in-out infinite;
      }

      main {
        position: relative;
        z-index: 1;
        width: min(28rem, 100%);
        padding: 2.5rem 2rem 2.25rem;
        text-align: center;
        background: color-mix(in srgb, white 72%, transparent);
        border: 1px solid color-mix(in srgb, white 80%, var(--violet));
        border-radius: 1.75rem;
        box-shadow:
          0 24px 60px color-mix(in srgb, var(--violet) 18%, transparent),
          0 2px 0 color-mix(in srgb, white 70%, transparent) inset;
        backdrop-filter: blur(16px);
      }

      .pill {
        display: inline-block;
        margin: 0 0 1rem;
        padding: 0.3rem 0.8rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: white;
        background: linear-gradient(90deg, var(--coral), var(--violet));
      }

      h1 {
        margin: 0;
        font-family: Fraunces, Georgia, serif;
        font-size: clamp(2.4rem, 8vw, 3.4rem);
        font-weight: 800;
        line-height: 1.05;
        background: linear-gradient(100deg, var(--coral), var(--violet) 55%, var(--teal));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .lede {
        margin: 0.9rem 0 1.6rem;
        font-size: 1.05rem;
        color: color-mix(in srgb, var(--ink) 72%, white);
      }

      .counter {
        display: grid;
        gap: 0.85rem;
        padding: 1.15rem;
        border-radius: 1.15rem;
        background: linear-gradient(180deg, #fff, #fff4e8);
        border: 2px solid color-mix(in srgb, var(--amber) 45%, white);
      }

      .label {
        margin: 0;
        font-size: 0.85rem;
        font-weight: 600;
        color: color-mix(in srgb, var(--ink) 60%, white);
      }

      button {
        appearance: none;
        font: inherit;
        font-weight: 600;
        font-size: 1.05rem;
        padding: 0.85rem 1.2rem;
        cursor: pointer;
        color: white;
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--coral), #ff8a3d 45%, var(--amber));
        box-shadow: 0 10px 24px color-mix(in srgb, var(--coral) 40%, transparent);
        transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
      }

      button:hover {
        transform: translateY(-2px) scale(1.02);
        filter: saturate(1.1);
        box-shadow: 0 14px 28px color-mix(in srgb, var(--coral) 48%, transparent);
      }

      button:active {
        transform: translateY(1px) scale(0.99);
      }

      @keyframes drift {
        0%,
        100% {
          transform: translate(0, 0);
        }
        50% {
          transform: translate(18px, -22px);
        }
      }
    </style>
  </head>
  <body>
    <div class="blob blob-a" aria-hidden="true"></div>
    <div class="blob blob-b" aria-hidden="true"></div>
    <div class="blob blob-c" aria-hidden="true"></div>
    <main>
      <p class="pill">CI/CD playground</p>
      <h1>{greeting}</h1>
      <p class="lede">A tiny Astro page with a splash of color. Click to count.</p>
      <div class="counter">
        <p class="label">Click the button to count.</p>
        <button type="button" id="count-btn">Clicked 0 times</button>
      </div>
    </main>
    <script>
      let count = 0;
      const button = document.getElementById("count-btn");
      button?.addEventListener("click", () => {
        count += 1;
        button.textContent = `Clicked ${count} time${count === 1 ? "" : "s"}`;
      });
    </script>
  </body>
</html>
